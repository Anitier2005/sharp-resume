{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-windows",
  "description": "设置窗口：独立的模型 / 外观窗，只能用事件与主窗口通信",
  "windows": ["settings-model", "settings-look"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-emit-to"
  ]
}
